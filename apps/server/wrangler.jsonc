{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "truco",
  "main": "src/index.ts",
  // Domínio próprio: no deploy a Cloudflare cria o DNS e o certificado de truco.riul.dev
  // (a zona riul.dev está na mesma conta). O endereço *.workers.dev continua valendo.
  "routes": [{ "pattern": "truco.riul.dev", "custom_domain": true }],
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] }],
  "observability": { "enabled": true },
}
