{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "truco",
  "main": "src/index.ts",
  // Custom domain: on deploy Cloudflare creates the DNS record and certificate for
  // truco.riul.dev (the riul.dev zone is in the same account). *.workers.dev keeps working.
  "routes": [{ "pattern": "truco.riul.dev", "custom_domain": true }],
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] }],
  "observability": { "enabled": true },
}
