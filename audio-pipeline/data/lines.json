  "lines": [
    {
      "id": "truco_001",
      "number": 1,
      "category": "truco",
      "text": "SUBI NO MURO, CAÍ DE COSTAS! TRUCO, SEU BOSTA!"
    },
    {
      "id": "truco_002",
      "number": 2,
      "category": "truco",
      "text": "TRUUUUUCO, DESGRAÇA!"
    },
    {
      "id": "truco_003",
      "number": 3,
      "category": "truco",
      "text": "TRUCO, LADRÃO! AQUI NÃO TEM MOLEZA!"
    },
    {
      "id": "truco_004",
      "number": 4,
      "category": "truco",
      "text": "TRUCO, FI DUMA ÉGUA!"
    },
    {
      "id": "truco_005",
      "number": 5,
      "category": "truco",
      "text": "CÊ ACHA QUE EU TÔ BRINCANDO? TRUUUCO!"
    },
    {
      "id": "truco_006",
      "number": 6,
      "category": "truco",
      "text": "TRUCO, SEU PÉ DE RATO!"
    },
    {
      "id": "truco_007",
      "number": 7,
      "category": "truco",
      "text": "TRUCO, MISERÁVEL! AGORA EU QUERO VER!"
    },
    {
      "id": "truco_008",
      "number": 8,
      "category": "truco",
      "text": "ÔÔÔ, MEU CONSAGRADO! TRUCO NESSA BAGAÇA!"
    },
    {
      "id": "six_001",
      "number": 9,
      "category": "six",
      "text": "SEIS, LADRÃO!"
    },
    {
      "id": "six_002",
      "number": 10,
      "category": "six",
      "text": "SEEEEEIS, SEU CORNO!"
    },
    {
      "id": "nine_001",
      "number": 11,
      "category": "nine",
      "text": "NOVE, DESGRAÇADO! AGORA AGUENTA!"
    },
    {
      "id": "twelve_001",
      "number": 12,
      "category": "twelve",
      "text": "DOZE! DOZE! DOZE! CÊ TÁ LASCADO!"
    },
    {
      "id": "nine_002",
      "number": 13,
      "category": "nine",
      "text": "PEDIU SEIS? ENTÃO TOMA NOVE, INFELIZ!"
    },
    {
      "id": "twelve_002",
      "number": 14,
      "category": "twelve",
      "text": "AQUI É DOZE, MEU FILHO! DOZE!"
    },
    {
      "id": "six_003",
      "number": 15,
      "category": "six",
      "text": "SEIS, SEU PÉ DE CHINELO!"
    },
    {
      "id": "nine_003",
      "number": 16,
      "category": "nine",
      "text": "NOVE! QUERO VER SE TEM CORAGEM!"
    },
    {
      "id": "taunt_001",
      "number": 17,
      "category": "taunt",
      "text": "CÊ JOGA TRUCO OU TÁ APRENDENDO A CONTAR?"
    },
    {
      "id": "taunt_002",
      "number": 18,
      "category": "taunt",
      "text": "ESSA CARTA AÍ NUM MATA NEM MOSQUITO!"
    },
    {
      "id": "taunt_003",
      "number": 19,
      "category": "taunt",
      "text": "MINHA VÓ JOGA MELHOR QUE VOCÊ, RAPAZ!"
    },
    {
      "id": "taunt_004",
      "number": 20,
      "category": "taunt",
      "text": "Ô MÃO RUIM DA DESGRAÇA!"
    },
    {
      "id": "taunt_005",
      "number": 21,
      "category": "taunt",
      "text": "CÊ TÁ COM MEDO? CHAMA SUA MÃE!"
    },
    {
      "id": "taunt_006",
      "number": 22,
      "category": "taunt",
      "text": "TÁ TREMENDO POR QUÊ, FILHO?"
    },
    {
      "id": "taunt_007",
      "number": 23,
      "category": "taunt",
      "text": "VAI CORRER? ENTÃO CORRE DIREITO!"
    },
    {
      "id": "taunt_008",
      "number": 24,
      "category": "taunt",
      "text": "ISSO AQUI É TRUCO, NÃO É REUNIÃO DE CONDOMÍNIO!"
    },
    {
      "id": "win_001",
      "number": 25,
      "category": "win",
      "text": "CHUPAAAA, DESGRAÇADO!"
    },
    {
      "id": "win_002",
      "number": 26,
      "category": "win",
      "text": "AQUI TEM CARTA, MEU PATRÃO!"
    },
    {
      "id": "win_003",
      "number": 27,
      "category": "win",
      "text": "RESPEITA O PAI, RAPAZ!"
    },
    {
      "id": "win_004",
      "number": 28,
      "category": "win",
      "text": "É O TREM! É O TREM!"
    },
    {
      "id": "win_005",
      "number": 29,
      "category": "win",
      "text": "ESSA FOI PRA ACABAR COM A AMIZADE!"
    },
    {
      "id": "win_006",
      "number": 30,
      "category": "win",
      "text": "PODE CHORAR QUE HOJE EU TÔ SEM LENÇO!"
    },
    {
      "id": "win_007",
      "number": 31,
      "category": "win",
      "text": "É TRUCO, NÃO É PRA QUALQUER UM!"
    },
    {
      "id": "win_008",
      "number": 32,
      "category": "win",
      "text": "EU AVISEI, SEU ANIMAL!"
    },
    {
      "id": "loss_001",
      "number": 33,
      "category": "loss",
      "text": "AH, VAI TOMAR BANHO, RAPAZ!"
    },
    {
      "id": "loss_002",
      "number": 34,
      "category": "loss",
      "text": "NÃO É POSSÍVEL UMA DESGRAÇA DESSA!"
    },
    {
      "id": "loss_003",
      "number": 35,
      "category": "loss",
      "text": "Ô PARCEIRO BURRO DA PESTE!"
    },
    {
      "id": "loss_004",
      "number": 36,
      "category": "loss",
      "text": "CÊ TINHA O ZAP E NÃO JOGOU?!"
    },
    {
      "id": "loss_005",
      "number": 37,
      "category": "loss",
      "text": "EU VOU EMBORA DESSA MESA!"
    },
    {
      "id": "loss_006",
      "number": 38,
      "category": "loss",
      "text": "ESSE BARALHO TÁ MARCADO, SÓ PODE!"
    },
    {
      "id": "loss_007",
      "number": 39,
      "category": "loss",
      "text": "NUNCA MAIS JOGO COM ESSE INFELIZ!"
    },
    {
      "id": "loss_008",
      "number": 40,
      "category": "loss",
      "text": "QUE JOGO DESGRAÇADO, SÔ!"
    }
  ],
  "tts_overrides": {
    "truco_002": "Truuuco, desgraça!",
    "six_002": "Seis, seu corno!"
  }
}
